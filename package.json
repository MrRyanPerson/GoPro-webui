{
	"name": "gopro-webui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "npm run frontend && npm run backend",
		"stop": "pm2 stop all",
		"restart": "pm2 restart all",
		"delete": "pm2 delete all",
		"monit": "pm2 monit",
		"frontend": "pm2 start build --name frontend --log logs/frontend.log",
		"backend": "pm2 start backend/main.py --name backend --log logs/backend.log",
		"dev": "pm2 start backend/main.py --watch -f && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"daisyui": "^5.7.22",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.1"
	},
	"dependencies": {
		"pm2": "^7.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
